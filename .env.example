# Discord bot token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Primary admin Discord ID (has full access including coupon generation)
# To get your ID: Enable developer mode in Discord settings -> Right-click your username -> Copy ID
PRIMARY_ADMIN_ID=your_discord_user_id_here

# Secondary admin IDs (comma-separated, no spaces)
# These admins can use all admin features EXCEPT generating coupons
# Example: 123456789012345678,987654321098765432
ADMIN_IDS=

# Session secret for Flask (generate a random string)
SESSION_SECRET=generate_a_random_string_here